# ── Required ──────────────────────────────────────────────────────────────────
MANAPOOL_EMAIL=you@example.com
MANAPOOL_TOKEN=your-access-token-here

# ── Discord (optional) ────────────────────────────────────────────────────────
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_BOT_TOKEN=your-bot-token-here
# DISCORD_GUILD_ID=123456789012345678   # guild ID for instant slash-command sync

# ── Paths ────────────────────────────────────────────────────────────────────
# DB_PATH=data/manabot.db
# REPORTS_DIR=data/reports
# SELL_RULES_PATH=data/sell_rules.csv   # per-card pricer strategy + min/max (see sell_rules.csv.example)

# ── Pricer / scheduler ────────────────────────────────────────────────────────
# PRICER_SCHEDULE_HOUR=2                # local hour to run daily update (default 2)
# PRICER_SCHEDULE_TIMEZONE=America/Chicago  # IANA timezone name (default Central)
# PRICER_RACE_TO_BOTTOM_THRESHOLD=0.20
# PRICER_RACE_TO_BOTTOM_MIN_GAP_USD=0.10
# PRICER_MIN_MARGIN_PCT=0.10
# PRICER_COST_FLOOR_DAYS=30
# PRICER_CROSS_MARKET_MIN_USD=20        # cap at the TCGPlayer target for cards worth at least this...
# PRICER_CROSS_MARKET_MAX_MP_QTY=4      # ...or with at most this many competing ManaPool copies
# PRICER_BOUNDS_REPORT_PCT=0.15         # report sell-rule listings priced this far outside min/max
